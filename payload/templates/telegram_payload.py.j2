def check_vm():
    vm_indicators = ["VMware", "VirtualBox", "QEMU", "Parallels"]
    try:
        import winreg
        for indicator in vm_indicators:
            try:
                key = winreg.OpenKey(winreg.HKEY_LOCAL_MACHINE, f"SYSTEM\\CurrentControlSet\\Services\\{indicator}")
                if key:
                    return True
            except:
                pass
    except:
        pass
    return False

if check_vm():
    sys.exit(1)
